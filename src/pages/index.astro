---
import '../styles/global.css';
---

<!doctype html>
<html lang="ca">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Gestor local de campionats de Butifarra." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Taula de Butifarra</title>
  </head>
  <body>
    <div id="tournament-app"></div>
    <script>
      import { mountTournament } from '../scripts/tournament';

      const root = document.querySelector<HTMLElement>('#tournament-app');
      if (root) mountTournament(root);
    </script>
  </body>
</html>
